# ============================================================
# 忽略规则
# 原则：版本控制里只留"源码 + 配置模板 + 可复现的脚本"，
#      密钥、本地产物、依赖目录、构建缓存一律不进仓库。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.log

# ---------- 本地配置（含密钥，绝不提交）----------
.env
.env.*
!.env.example

# ---------- 本地数据产物 ----------
# 数据库与向量索引都能重新生成，提交它们只会让仓库变胖、且每次跑完都产生 diff。
# 生成方式见 README「快速开始」：
#   python -m app.agent.database.init_database
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/chroma/
!backend/data/.gitkeep

# ---------- 前端 ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.tsbuildinfo
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---------- 编辑器与系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
