# ============================================================
# 环境变量模板
# 使用方式：复制本文件为 .env，然后按注释填写
#   PowerShell: Copy-Item .env.example .env
# 重要：.env 里不要加引号，不要加多余空格，改完保存后重启程序才生效
# ============================================================

# ==================== 大语言模型配置 ====================

# 提供方标识，仅用于日志打印时区分，代码逻辑不依赖这个值
LLM_PROVIDER=openai

# API 密钥，必填。这里的示例值请务必替换成你自己的
# OpenAI 官方: sk-xxxx        DeepSeek: sk-xxxx
# 通义千问: sk-xxxx           智谱: xxxx.xxxx
LLM_API_KEY=sk-replace-me

# 接口地址。用官方 OpenAI 就保持默认；用国内服务改成对应地址，必须带 /v1 结尾
#   OpenAI:   https://api.openai.com/v1
#   DeepSeek: https://api.deepseek.com/v1
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱:     https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称。项目里所有模型实例都由这个值决定，换模型只改这里
#   生成 SQL 和写报告这类任务，建议用能力较强的模型，效果差别很明显
LLM_MODEL=gpt-4o-mini

# 采样温度，范围 0-2。
#   重要：Text-to-SQL 和结构化输出场景必须用 0，否则同一个问题每次生成的 SQL 都不一样，
#        评测时无法定位问题是模型随机性还是 Prompt 设计问题
LLM_TEMPERATURE=0

# 单次回复的最大 token 数。设太小会导致长报告被截断，设太大会增加成本
LLM_MAX_TOKENS=2000

# 单次请求超时秒数。超过这个时间 SDK 会抛超时异常，由上层重试逻辑处理
LLM_TIMEOUT=60

# SDK 层面的自动重试次数，主要应对网络抖动和 429 限流
LLM_MAX_RETRIES=2

# 离线模拟开关。true 表示所有模型调用都走本地替身，不联网、零成本、无需 API Key。
#   适合场景：还没配密钥就想先把流程跑通；或者调试图结构时不想花钱。
#   注意：模拟模型的产出全部带 MOCK 标记，不具备任何事实参考价值。
#   配好真实密钥后，把这一行改成 false（或删掉这一行）即可切回真实模型。
LLM_MOCK=true

# 是否在每次请求里显式关闭模型的思考模式（thinking）。
#   什么时候必须设 true：DeepSeek V4 默认开启思考模式，此时
#     ① 温度会被静默忽略（本项目全靠温度 0 保证 SQL 可复现）
#     ② 思考过程本身占用 max_tokens，实测 max_tokens=64 时正文被挤成空字符串
#     ③ 不接受被强制指定的 tool_choice，结构化输出直接报 400
#        实测报错原文：Thinking mode does not support this tool_choice
#   OpenAI 等服务商不认识这个参数，保持默认 false 即可。
LLM_DISABLE_THINKING=false

# 结构化输出（with_structured_output）的实现方式，三选一：
#   json_schema      对输出约束最强，但部分服务商不支持。
#                    实测 DeepSeek 返回：This response_format type is unavailable now
#   function_calling 走工具调用，兼容性最好，作为默认值
#   json_mode        要求 Prompt 里出现 json 字样才可用
LLM_STRUCTURED_METHOD=function_calling

# 向量化模型是否强制使用离线替身，与 LLM_MOCK 相互独立。
#   什么时候用：DeepSeek 只提供对话模型、没有向量化接口，这时对话走真实模型、
#               向量化只能留在本地替身，否则 Schema 检索环节整条链路失败。
#   注意：切换这个开关后 Chroma 里已建好的索引必须重建（FORCE_REINDEX=true），
#        因为真实模型与替身的向量维度不一定相同。
EMBEDDING_MOCK=false


# ==================== 向量化模型配置 ====================

# 向量化模型提供方
EMBEDDING_PROVIDER=openai

# 向量化模型的密钥。多数服务商与 LLM 共用密钥，留空则自动复用 LLM_API_KEY
EMBEDDING_API_KEY=

# 向量化模型接口地址。留空则自动复用 LLM_BASE_URL
EMBEDDING_BASE_URL=

# 向量化模型名称。它的输出维度必须和下面 EMBEDDING_DIM 一致
EMBEDDING_MODEL=text-embedding-3-small

# 向量维度，必须与所选模型真实输出维度一致，否则 Chroma 建库时会报维度不匹配
#   text-embedding-3-small = 1536    text-embedding-3-large = 3072
#   BGE-M3（本地/国内）= 1024        通义 text-embedding-v3 = 1024
EMBEDDING_DIM=1536


# ==================== 数据库配置 ====================

# 数据库连接串，代码通过 SQLAlchemy 访问，换数据库只改这一行
#   SQLite（默认，零配置）: sqlite:///./data/ecommerce.db
#   PostgreSQL（需先 docker compose up -d）:
#   postgresql+psycopg://agent:agent123@localhost:5432/ecommerce
DB_URL=sqlite:///./data/ecommerce.db

# 执行 SQL 前，校验层会强制给查询加上行数上限，防止 SELECT * 拉回整张表
SQL_ROW_LIMIT=500

# SQL 执行超时秒数，防止慢查询把整个服务拖住
SQL_TIMEOUT_SECONDS=10

# SQL 生成失败后的最大重试次数（含首次），即最多让模型自我修正 (值-1) 次
SQL_MAX_RETRIES=2

# Schema 检索时召回的表数量。设太大会让 Prompt 变长、干扰模型判断；设太小可能漏表
SCHEMA_TOP_K=3


# ==================== 向量库与缓存配置 ====================

# Chroma 持久化目录。索引建在这里，程序重启后不用重建
CHROMA_PERSIST_DIR=./data/chroma

# Redis 连接串，会话记忆使用
REDIS_URL=redis://localhost:6379/0

# 是否每次启动都强制重建索引。调试索引逻辑时开 true，日常保持 false
# 注意：开启后每次启动都会重新调用向量化接口，产生真实费用
FORCE_REINDEX=false


# ==================== 搜索工具配置 ====================

# Tavily 搜索 API 密钥，检索节点使用
# 获取地址：https://tavily.com （有免费额度，够做项目）
TAVILY_API_KEY=tvly-replace-me

# 单次检索返回的结果条数
SEARCH_MAX_RESULTS=5


# ==================== 前后端分离配置 ====================

# 允许跨域访问的前端地址，逗号分隔。
# 前端开发服务器（Vite）默认跑在 5173 端口，与后端（8000）不同源，
# 不配这一项浏览器会按同源策略拦掉请求，表现是"接口在 Postman 里正常，
# 在页面上却一直失败"，且浏览器控制台会报 CORS 错误。
# 生产部署时改成真实域名，例如 https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
